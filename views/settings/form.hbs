<header class="page-head">
  <h1>Settings</h1>
</header>

{{#if saved}}
  <div class="callout callout-ok">Settings saved. Existing invoices are unaffected.</div>
{{/if}}

{{#if errors.length}}
  <div class="callout callout-error">
    <strong>Please fix the following:</strong>
    <ul>{{#each errors}}<li>{{this}}</li>{{/each}}</ul>
  </div>
{{/if}}

<form method="post" action="/settings" autocomplete="off">
  <section class="card">
    <h2>Your business</h2>
    <p class="muted">Copied onto each invoice when it is generated, so changes here never rewrite past invoices.</p>
    <div class="field-grid">
      <label class="field span-2">
        <span>Business name</span>
        <input type="text" name="business_name" value="{{settings.business_name}}" required>
      </label>
      <label class="field">
        <span>Tagline</span>
        <input type="text" name="business_tagline" value="{{settings.business_tagline}}"
               placeholder="Custom Software Development">
      </label>
      <label class="field">
        <span>Address line 1</span>
        <input type="text" name="address_line1" value="{{settings.address_line1}}">
      </label>
      <label class="field">
        <span>Address line 2</span>
        <input type="text" name="address_line2" value="{{settings.address_line2}}">
      </label>
      <label class="field">
        <span>City, state, ZIP</span>
        <input type="text" name="city_state_zip" value="{{settings.city_state_zip}}">
      </label>
      <label class="field">
        <span>Email</span>
        <input type="email" name="email" value="{{settings.email}}">
      </label>
      <label class="field">
        <span>Phone</span>
        <input type="text" name="phone" value="{{settings.phone}}">
      </label>
      <label class="field">
        <span>Tax ID</span>
        <input type="text" name="tax_id" value="{{settings.tax_id}}" placeholder="EIN 87-1234567">
      </label>
    </div>
  </section>

  <section class="card">
    <h2>Invoice defaults</h2>
    <div class="field-grid">
      <label class="field">
        <span>Default hourly rate</span>
        <input type="number" name="default_rate" value="{{settings.default_rate}}" min="0" step="0.01">
      </label>
      <label class="field">
        <span>Default terms (days)</span>
        <input type="number" name="default_terms_days" value="{{settings.default_terms_days}}" min="0" step="1">
      </label>
      <div class="field"></div>
      <label class="field span-3">
        <span>Payment instructions</span>
        <textarea name="payment_instructions" rows="4">{{settings.payment_instructions}}</textarea>
        <small>One line per row</small>
      </label>
      <label class="field span-3">
        <span>Notes &amp; terms</span>
        <textarea name="notes" rows="4">{{settings.notes}}</textarea>
      </label>
      <label class="field span-3">
        <span>Closing message</span>
        <input type="text" name="footer_message" value="{{settings.footer_message}}">
      </label>
    </div>
  </section>

  <div class="form-actions">
    <button class="btn btn-primary" type="submit">Save settings</button>
  </div>
</form>
