# Copy to .env and set the path to your SQLite database file.
#
# Accepts either a plain filesystem path or a file: URL. The app does not
# create the parent directory -- it must already exist -- and it has no
# default, so this variable is required.
#
#   DATABASE_URL=/Users/you/Somewhere/invoices.db
#   DATABASE_URL=file:///Users/you/Somewhere/invoices.db
#   DATABASE_URL=~/Somewhere/invoices.db

DATABASE_URL=

# Optional. Defaults shown.
# PORT=3000
# HOST=127.0.0.1
